# Optional TronGrid API key. Webpack reads process.env at build time (like MODE)
# and injects it into TRONGRID_API_KEY (src/constants/tron_nodes.ts) via
# DefinePlugin. Leave empty to call TronGrid without a key (lower rate limit).
#
#   TRON_PRO_API_KEY=your-key pnpm build:prd:chrome
#
# Get a key at https://www.trongrid.io/
TRON_PRO_API_KEY=
