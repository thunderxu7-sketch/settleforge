{
  "name": "@settleforge/extension",
  "version": "0.1.0",
  "description": "SettleForge independent extension client",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:clear": "jest --clearCache",
    "tsbuild": "tsc",
    "tsbuild:prd": "tsc --p tsconfig.prd.json",
    "start": "webpack --watch --progress --config config/webpack.dev.js",
    "start:server": "node config/webserver.js",
    "start:background": "node config/background.js",
    "build": "webpack --progress --config config/webpack.dev.js",
    "build:prd:chrome": "webpack --progress --config config/webpack.prd.js",
    "clean:prd": "rm -rf dist/prd/ && rm -rf chrome-extension.zip",
    "zip:prd:chrome:test": "pnpm clean:prd && MODE=development pnpm build:prd:chrome && cd dist/prd/ && pnpx bestzip ../chrome-extension.zip ./*",
    "zip:prd:chrome": "pnpm clean:prd && MODE=production pnpm build:prd:chrome && cd dist/prd/ && pnpx bestzip ../chrome-extension.zip ./*",
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "ana": "webpack --config ./config/webpack.prd.analyzer.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
